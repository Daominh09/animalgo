# Supabase
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
# No shared JWT secret needed here — auth.py verifies tokens against
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json (asymmetric signing keys).

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=animalgo-photos
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Species ID vision. Gemini is tried first; OpenRouter is the fallback, used when
# GEMINI_API_KEY is blank or the Gemini call fails. At least one must be set.
# Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter — free key at https://openrouter.ai/keys. The default model is a free
# vision-capable one, so no billing setup is needed.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=google/gemma-4-31b-it:free

# Redis
REDIS_URL=redis://localhost:6379

# GBIF — no token required. IUCN Red List status is sourced via GBIF too
# (api.gbif.org/.../iucnRedListCategory), so no IUCN API token is needed.
